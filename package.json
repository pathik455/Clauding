{
  "name": "clauding",
  "displayName": "Clauding",
  "description": "Retro arcade mini-games (Pixel Snake & Block Invaders) directly in VS Code while Claude runs background tasks!",
  "version": "0.0.1",
  "publisher": "pathik455",
  "author": {
    "name": "pathik455"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pathik455/Clauding.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "game",
    "arcade",
    "snake",
    "claude",
    "retro"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "clauding.openGame",
        "title": "Clauding: Play Games",
        "icon": "$(game)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "clauding.openGame",
          "group": "navigation",
          "when": "!claudingActive"
        }
      ],
      "commandPalette": [
        {
          "command": "clauding.openGame"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node build.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.25.0"
  }
}
